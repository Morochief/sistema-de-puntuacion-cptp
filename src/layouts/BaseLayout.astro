---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="cptp-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description ?? "App de puntuación CPTP .22 LR — tiro de precisión Long Range"} />

    <!-- PWA & Theme -->
    <meta name="theme-color" content="#080d16" />
    <meta name="background-color" content="#080d16" />
    <meta name="color-scheme" content="dark" />

    <!-- iOS PWA -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CPTP Scoring" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Icons & Fonts -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">

    <!-- OpenGraph (para compartir) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? "App de puntuación CPTP .22 LR"} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
  </head>
  <body>
    <!-- Marcas de agua en el fondo -->
    <div class="watermark-left no-print" aria-hidden="true"></div>
    <div class="watermark-right no-print" aria-hidden="true"></div>

    <!-- Navbar táctica -->
    <header class="app-navbar" role="banner">
      <div style="max-width:768px;margin:0 auto;padding:0 16px;display:flex;align-items:center;justify-content:space-between;height:70px;gap:8px;">

        <!-- Logo CPTP + título -->
        <a href="#/" style="display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;" aria-label="Inicio — CPTP Scoring">
          <img src="/logo-cptp.svg" alt="CPTP Logo" style="height:50px;width:auto;object-fit:contain;" onerror="this.style.display='none';" />
          <span style="font-family:'Orbitron',sans-serif;font-weight:900;font-size:1.25rem;letter-spacing:0.04em;color:#0f1f3d;white-space:nowrap;">CPTP <span style="color:#b7201c">.22 LR</span></span>
        </a>

        <!-- Bandera de Paraguay (centro) + Sincronización -->
        <div style="display:flex;align-items:center;gap:10px;">
          <button id="btn-cloud-sync" title="Sincronizar base de datos con Supabase" style="padding:4px 8px;border-radius:8px;border:1px solid #cbd5e1;display:flex;align-items:center;gap:4px;cursor:pointer;background:#ffffff;box-shadow:0 1px 2px rgba(0,0,0,0.05);outline:none;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0056b3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v13m0 0-4-4m4 4 4-4"/>
              <path d="M4 20h16"/>
            </svg>
            <span style="font-size:0.72rem;font-weight:800;color:#0056b3;font-family:'Rajdhani',sans-serif;text-transform:uppercase;">Subir</span>
          </button>
          <img src="/flag-paraguay.svg" alt="Bandera de Paraguay" style="height:26px;width:auto;border-radius:3px;box-shadow:0 1px 4px rgba(0,0,0,0.15);border:1px solid rgba(0,0,0,0.06);" />
          <div id="offline-indicator" style="display:none;"></div>
        </div>

        <!-- Logo Long Range (derecha) -->
        <div style="display:flex;align-items:center;justify-content:center;height:50px;flex-shrink:0;">
          <img src="/logo-long-range.svg" alt="Long Range .22 LR" style="height:50px;width:auto;object-fit:contain;" onerror="this.style.display='none';" />
        </div>

      </div>
    </header>

    <!-- Main -->
    <main style="max-width:768px;margin:0 auto;padding:16px 16px 80px;position:relative;z-index:1;" role="main">
      <slot />
    </main>

    <!-- Toast container -->
    <div id="toast-container" role="region" aria-label="Notificaciones" aria-live="polite"></div>

    <!-- Offline detection script -->
    <script>
      (function () {
        const indicator = document.getElementById('offline-indicator');
        if (!indicator) return;
        function update() {
          indicator.classList.toggle('hidden', navigator.onLine);
        }
        window.addEventListener('online', update);
        window.addEventListener('offline', update);
        update();
      })();
    </script>
  </body>
</html>
