---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CPTP .22 LR Scoring" description="App de puntuación para tiro .22 Long Range — funciona offline">
  <div id="app-root">

    <!-- ── Vista: Login ──────────────────────────────────── -->
    <div id="view-login" class="view hidden">
      <!-- JS renderiza aquí -->
    </div>

    <!-- ── Vista: Dashboard ──────────────────────────────── -->
    <div id="view-dashboard" class="view">
      <!-- Hero header -->
      <div style="margin-bottom:28px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;">
          <div>
            <div style="font-family:'Rajdhani',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#475569;margin-bottom:2px;">
              Sistema de Puntuación
            </div>
            <h1 id="dashboard-title" style="margin:0;font-family:'Rajdhani',sans-serif;font-size:1.9rem;font-weight:700;color:#0056b3;letter-spacing:0.01em;">
              Mis Eventos
            </h1>
          </div>
          <button id="btn-new-event" class="btn-primary-custom admin-only"
                  style="white-space:nowrap;display:none;"
                  aria-label="Crear nuevo evento de tiro">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Nuevo Evento
          </button>
        </div>
      </div>

      <!-- TABS DE NAVEGACIÓN DASHBOARD -->
      <div class="tabs tabs-boxed mb-6" style="background:#e2e8f0;border:1px solid #cbd5e1;display:flex;gap:4px;padding:4px;border-radius:12px;margin-bottom:20px;">
        <button id="dash-tab-btn-eventos" class="tab tab-active" style="flex:1;border-radius:8px;font-family:'Rajdhani',sans-serif;font-weight:700;color:#0f172a;">
          Mis Eventos
        </button>
        <button id="dash-tab-btn-campeonato" class="tab" style="flex:1;border-radius:8px;font-family:'Rajdhani',sans-serif;font-weight:700;color:#475569;">
          Campeonato General
        </button>
      </div>

      <!-- Panel 1: Lista de eventos (poblada por JS) -->
      <div id="dash-panel-eventos">
        <section id="event-list-container" aria-label="Lista de eventos de tiro">
          <!-- JS renderiza aquí -->
        </section>
      </div>

      <!-- Panel 2: Campeonato General -->
      <div id="dash-panel-campeonato" class="hidden">
        <section id="championship-container" aria-label="Tabla de Campeonato General">
          <!-- JS renderiza aquí -->
        </section>
      </div>
    </div>

    <!-- ── Vista: Nuevo Evento ────────────────────────────── -->
    <div id="view-new-event" class="view hidden">
      <div id="new-event-container">
        <!-- JS renderiza aquí -->
      </div>
    </div>

    <!-- ── Vista: Analíticas ────────────────────────────── -->
    <div id="view-analytics" class="view hidden">
      <!-- JS renderiza aquí -->
    </div>

    <!-- ── Vista: Detalle de Evento ──────────────────────── -->
    <div id="view-event" class="view hidden">
      <div id="event-detail-container">
        <!-- JS renderiza aquí -->
      </div>
    </div>

    <!-- ── Vista: Serie / Scoring ────────────────────────── -->
    <div id="view-series" class="view hidden">
      <div id="series-container">
        <!-- JS renderiza aquí -->
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  import '../lib/app';
</script>
